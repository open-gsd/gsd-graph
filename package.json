{
  "name": "@opengsd/gsd-graph",
  "version": "0.2.0",
  "description": "Graph Engineering toolkit — extract, normalize, store, query, ground knowledge graphs, and discover global themes via community detection",
  "license": "MIT",
  "author": "Jeremy McSpadden <jeremy@fluxlabs.net>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gsd-graph": "./bin/gsd-graph.js",
    "gsd-graph-mcp": "./bin/gsd-graph-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "prompts",
    "ontology-packs",
    "skills",
    "hooks",
    "scripts",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test dist-test/**/*.test.js",
    "test:coverage": "npm run build && npm run build:test && c8 --check-coverage --lines 80 node --test dist-test/**/*.test.js",
    "install-gsd": "node scripts/install-gsd-integration.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "c8": "^12.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "graph-engineering",
    "knowledge-graph",
    "graph-rag",
    "triples",
    "ontology"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-gsd/gsd-graph.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/open-gsd/gsd-graph#readme",
  "bugs": {
    "url": "https://github.com/open-gsd/gsd-graph/issues"
  }
}
