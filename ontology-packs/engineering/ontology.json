{
  "id": "engineering",
  "version": "1",
  "title": "Engineering systems",
  "node_types": [
    "Entity",
    "Person",
    "Organization",
    "Service",
    "API",
    "Incident",
    "Decision",
    "Change",
    "Document",
    "Concept",
    "Event",
    "Topic"
  ],
  "predicates": [
    { "id": "related_to", "domain": ["*"], "range": ["*"] },
    { "id": "mentions", "domain": ["*"], "range": ["*"] },
    { "id": "depends_on", "domain": ["*"], "range": ["*"] },
    { "id": "blocked_by", "domain": ["*"], "range": ["*"] },
    { "id": "requires", "domain": ["*"], "range": ["*"] },
    { "id": "uses", "domain": ["*"], "range": ["*"] },
    { "id": "implements", "domain": ["*"], "range": ["*"] },
    { "id": "delivers", "domain": ["*"], "range": ["*"] },
    { "id": "precedes", "domain": ["*"], "range": ["*"] },
    { "id": "supports", "domain": ["*"], "range": ["*"] },
    {
      "id": "owns",
      "domain": ["Person", "Organization"],
      "range": ["Service", "API", "Document"]
    },
    {
      "id": "mitigates",
      "domain": ["Change", "Decision", "Service"],
      "range": ["Incident"]
    },
    {
      "id": "deploys",
      "domain": ["Change", "Person", "Organization"],
      "range": ["Service", "API"]
    },
    {
      "id": "causes",
      "domain": ["Event", "Change", "Incident"],
      "range": ["Incident", "Event"]
    },
    {
      "id": "about",
      "domain": ["Document", "Decision", "Incident"],
      "range": ["Service", "API", "Concept"]
    },
    { "id": "part_of", "domain": ["*"], "range": ["*"] },
    { "id": "same_as", "domain": ["*"], "range": ["*"] }
  ],
  "strict": true,
  "unknown_predicate_policy": "review",
  "unknown_type_policy": "review"
}
