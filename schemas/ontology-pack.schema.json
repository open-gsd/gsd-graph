{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengsd.dev/schemas/ontology-pack.schema.json",
  "title": "gsd-graph ontology pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "node_types",
    "predicates"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "node_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "range"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "range": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "strict": {
      "type": "boolean"
    },
    "unknown_predicate_policy": {
      "type": "string",
      "enum": ["review", "coerce", "drop"]
    },
    "unknown_type_policy": {
      "type": "string",
      "enum": ["review", "coerce", "drop"]
    }
  }
}
